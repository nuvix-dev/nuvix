{
  "name": "nuvix-next",
  "private": true,
  "type": "module",
  "description": "Nuvix v2 — Bun-native backend platform",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "build:bundle": "bun run build.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "^1.4.4",
    "openapi-types": "12.1.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@elysia/openapi": "^2.0.0-rc.1",
    "elysia": "2.0.0-rc.1",
    "typebox": "1.3.19"
  }
}
